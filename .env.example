# Copie esse arquivo pra ".env" e preencha com os valores reais.
# Nunca commitar o ".env" de verdade — ele já está no .gitignore.

# API key do Buffer (Settings → API → Create a new API key)
BUFFER_API_KEY=

# ID do canal do Instagram dentro do Buffer (ver marketing/automacao-buffer-setup.md, Parte D)
BUFFER_CHANNEL_ID=

# URL pública onde as imagens do carrossel ficam hospedadas (GitHub Pages)
# ATENÇÃO: tem que apontar pra pasta onde o site realmente é servido, não pra
# raiz do Pages. Nesse repositório o Pages publica a partir da raiz e o site
# mora em /site, então a URL termina em "/site". Errar isso faz o Buffer
# receber 404 na imagem e o post falhar sem explicação óbvia.
# Confira com: curl -I <SITE_URL>/img/posts/<slug>/slide-01.png  (tem que dar 200)
# Ex: https://seuusuario.github.io/nome-do-repo/site
SITE_URL=

# --- Caminho alternativo (Meta Graph API direto, exige CNPJ) ---
# Só preencher se migrar pra marketing/automacao-meta-setup.md
# META_PAGE_ACCESS_TOKEN=
# META_PAGE_ID=
# META_IG_USER_ID=
